<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Deliberately NOT sandboxed. The App Sandbox and Accessibility access
      are mutually exclusive in practice: a sandboxed app cannot create the
      CGEventTap this one is built around, so adding
      com.apple.security.app-sandbox here would break recording, playback
      and hotkeys all at once. That also rules out the Mac App Store —
      Developer ID distribution is the only route for an app like this.
    -->

    <!-- Scripts drive other apps through osascript, which is Apple Events. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!--
      Interpreters are launched as child processes: python3, node, and the
      luau binary MacroGlass downloads into Application Support. Under the
      hardened runtime a child that isn't signed by the same team is still
      fine — it's a separate process with its own signature — but the
      downloaded luau needs to be loadable, which is why the installer
      ad-hoc signs it after unpacking.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
